    )

    predicted_disease = (
        label_encoder.inverse_transform(
            [y_pred[i]]
        )[0]
    )

    probabilities_test = (
        model.predict_proba(
            X_test[i].reshape(1, -1)
        )[0]
    )

    confidence_test = (
        np.max(
            probabilities_test
        ) * 100
    )

    if actual_disease == predicted_disease:

        result = "Correct"

    else:

        result = "Incorrect"


    results.append([
        i + 1,
        actual_disease,
        predicted_disease,
        round(
            confidence_test,
            2
        ),
        result
    ])


prediction_table = pd.DataFrame(

