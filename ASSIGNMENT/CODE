    # Convert to array
    img_array = np.array(
        img_resized
    )

    # Normalize
    img_array = img_array / 255.0

    # Flatten
    img_array = img_array.flatten()

    # Reshape for model
    img_array = img_array.reshape(
        1,
        -1
    )

    # Predict disease
    prediction = model.predict(
        img_array
    )

    # Convert prediction to class name
    predicted_class = (
        label_encoder.inverse_transform(
            prediction
        )[0]
    )

    # Get probabilities
    probabilities = model.predict_proba(
        img_array
    )[0]

    # Get confidence
    confidence = (
        np.max(probabilities) * 100
    )

    # Display image
    plt.figure(figsize=(6, 6))

    plt.imshow(img)

    plt.axis("off")

    plt.title(
        f"Predicted Disease:\n"
        f"{predicted_class}\n"
        f"Confidence: {confidence:.2f}%"
    )

    plt.show()

    print(
        "\nInput Image      :",
        os.path.basename(test_image)
    )

    print(
        "Predicted Disease:",
        predicted_class
    )

    print(
        "Confidence       :",
        round(confidence, 2),
        "%"
    )

