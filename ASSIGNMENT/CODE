# ============================================================
# 8. IMAGE PREPROCESSING
# ============================================================

IMG_SIZE = 32

# To reduce computational requirements,
# 100 images are selected from each class.

MAX_IMAGES_PER_CLASS = 100

X = []
y = []

np.random.seed(42)


# ============================================================
# 9. LOAD AND PREPROCESS IMAGES
# ============================================================

print("\nLoading images...")

for class_name in classes:

    folder_path = os.path.join(
        DATASET_PATH,
        class_name
    )

    image_files = [
        file
        for file in os.listdir(folder_path)
        if file.lower().endswith(
            (".jpg", ".jpeg", ".png")
        )
    ]

    # Shuffle images
    np.random.shuffle(image_files)

    # Select limited number of images
    image_files = image_files[:MAX_IMAGES_PER_CLASS]

    for file in image_files:

        image_path = os.path.join(
            folder_path,
            file
        )

        try:

            # Open image
            image = Image.open(
                image_path
            ).convert("RGB")

            # Resize image
            image = image.resize(
                (IMG_SIZE, IMG_SIZE)
            )

            # Convert image to NumPy array
            image_array = np.array(image)

            # Normalize pixel values
            image_array = image_array / 255.0

            # Flatten image
            image_array = image_array.flatten()

            X.append(image_array)
            y.append(class_name)

        except Exception as e:

            print(
                "Error loading:",
                image_path
            )


X = np.array(X)
y = np.array(y)


# ============================================================
# 10. DISPLAY PREPROCESSING INFORMATION
# ============================================================

print("\nPreprocessing completed.")

print("Total selected images:", len(X))

print("Image size:",
      IMG_SIZE,
      "x",
      IMG_SIZE,
      "x 3")

print("Features per image:", X.shape[1])

print("Number of classes:", len(np.unique(y)))


# ============================================================
# 11. SPLIT DATASET
# ============================================================

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42,
    stratify=y
)

print("\nDataset Split")
print("-" * 40)

print("Training samples:", len(X_train))
print("Testing samples :", len(X_test))


# ============================================================
# 12. LABEL ENCODING
# ============================================================

label_encoder = LabelEncoder()

y_train_encoded = label_encoder.fit_transform(
    y_train
)

y_test_encoded = label_encoder.transform(
    y_test
)

print("\nLabel encoding completed.")

print("Number of encoded classes:",
      len(label_encoder.classes_))


# ============================================================
# 13. BUILD NEURAL NETWORK MODEL
# ============================================================

print("\nCreating Neural Network model...")

model = MLPClassifier(

    hidden_layer_sizes=(128, 64),

    activation="relu",

    solver="adam",

    max_iter=100,

    batch_size=32,

    learning_rate_init=0.001,

    early_stopping=True,

    validation_fraction=0.1,

    random_state=42,

    verbose=True
)


# ============================================================
# 14. TRAIN NEURAL NETWORK
# ============================================================

print("\nTraining Neural Network...")

model.fit(
    X_train,
    y_train_encoded
)

print("\nTraining completed.")


# ============================================================
# 15. PREDICTION ON TEST DATA
# ============================================================

y_pred = model.predict(X_test)


# ============================================================
# 16. CALCULATE ACCURACY
# ============================================================

accuracy = accuracy_score(
    y_test_encoded,
    y_pred
)

print("\n" + "=" * 60)
print("MODEL PERFORMANCE")
print("=" * 60)

print(
    "Neural Network Accuracy:",
