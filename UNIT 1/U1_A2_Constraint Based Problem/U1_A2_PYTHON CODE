from collections import deque
import heapq
def doctor_scheduling():
    doctors = ["D1", "D2", "D3"]
    shifts = ["Morning", "Afternoon", "Night"]
    assignment = {}
    def is_valid(doctor, shift):
        if doctor == "D1" and shift == "Night":
            return False
        if doctor == "D3" and shift == "Morning":
            return False
        if shift in assignment.values():
            return False
        return True
    def backtrack(index):
        if index == len(doctors):
            order = {"Morning": 0, "Afternoon": 1, "Night": 2}
            return order[assignment["D2"]] < order[assignment["D3"]]
        doctor = doctors[index]
        for shift in shifts:
            if is_valid(doctor, shift):
                assignment[doctor] = shift
                if backtrack(index + 1):
                    return True
                del assignment[doctor]
        return False
    print("\nDoctor Scheduling using Backtracking\n")
    if backtrack(0):
        print("Valid Schedule")
        for doctor in doctors:
            print(doctor, "->", assignment[doctor])
    else:
        print("No valid schedule found")
def bfs_robot():
    grid = [
        ['S','.','.','X','.'],
        ['.','X','.','X','.'],
        ['.','X','.','.','.'],
        ['.','.','X','X','.'],
        ['X','.','.','.','G']
    ]
    rows = len(grid)
    cols = len(grid[0])
    start = (0,0)
    goal = (4,4)
    moves = [(0,1),(1,0),(0,-1),(-1,0)]
    queue = deque()
    queue.append((start,[start]))
    visited = set()
    visited.add(start)
    print("\nRobot Navigation using BFS\n")
    while queue:
        current,path = queue.popleft()
        if current==goal:
            print("Shortest Path")
            print(path)
            print("Total Cost =",len(path)-1)
            return
        x,y=current
        for dx,dy in moves:
            nx=x+dx
            ny=y+dy
            if 0<=nx<rows and 0<=ny<cols:
                if grid[nx][ny]!='X' and (nx,ny) not in visited:
                    visited.add((nx,ny))
                    queue.append(((nx,ny),path+[(nx,ny)]))
def rescue_robot():
    grid = [
        ['S','.','R','.','.'],
        ['.','X','.','X','.'],
        ['.','.','.','R','.'],
        ['X','.','X','.','.'],
        ['.','.','.','.','G']
    ]
    rows=len(grid)
    cols=len(grid[0])
    start=(0,0)
    goal=(4,4)
    moves=[(0,1),(1,0),(0,-1),(-1,0)]
    pq=[]
    heapq.heappush(pq,(0,start,[start]))
    visited={}
    print("\nAutonomous Rescue Robot using Uniform Cost Search\n")
    while pq:
        cost,current,path=heapq.heappop(pq)
        if current==goal:
            print("Goal Reached")
            print("Path =",path)
            print("Minimum Cost =",cost)
            return
        if current in visited and visited[current]<=cost:
            continue
        visited[current]=cost
        x,y=current
        for dx,dy in moves:
            nx=x+dx
            ny=y+dy
            if 0<=nx<rows and 0<=ny<cols:
                if grid[nx][ny]!='X':
                    new_cost=cost+1
                    if grid[nx][ny]=='R':
                        new_cost+=2
                    heapq.heappush(
                        pq,
                        (new_cost,(nx,ny),path+[(nx,ny)])
                    )
