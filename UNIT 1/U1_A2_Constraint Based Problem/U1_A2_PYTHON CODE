def convex_hull():
    def orientation(p,q,r):
        return (q[1]-p[1])*(r[0]-q[0])-(q[0]-p[0])*(r[1]-q[1])
    points=[(1,1),(2,5),(5,3),(3,2),(4,6),(6,1)]
    n=len(points)
    hull=[]
    print("\nBrute Force Convex Hull\n")
    for i in range(n):
        for j in range(i+1,n):
            left=0
            right=0
            for k in range(n):
                if k==i or k==j:
                    continue
                value=orientation(points[i],points[j],points[k])
                if value>0:
                    left+=1
                elif value<0:
                    right+=1
            if left==0 or right==0:
                hull.append((points[i],points[j]))
    print("Convex Hull Edges")
    for edge in hull:
        print(edge)
